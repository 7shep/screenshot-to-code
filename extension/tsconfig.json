{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "rootDir": ".",
    "outDir": "dist-tsc",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "sourceMap": true,
    "paths": {
      "../src/*": ["../src/*"]
    }
  },
  "include": ["src/**/*", "webview/**/*"],
  "exclude": ["dist", "dist-tsc", "node_modules"]
}
