{
  "name": "screenshot-to-code",
  "version": "1.2.0",
  "description": "CLI that converts UI screenshots into React TSX components using Gemini",
  "type": "module",
  "bin": {
    "s2c": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.0",
    "chalk": "^5.3.0",
    "dotenv": "^17.4.2",
    "ora": "^8.1.1",
    "postcss": "^8.5.15",
    "ts-morph": "^28.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^4.1.7",
    "typescript": "^5.5.0",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
